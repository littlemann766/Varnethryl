config_version=5

[application]

config/test_build=33
config/name="Varnethryl"
config/version="1.9.3"
config/icon="res://branding/icon_192.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

VPrefs="*res://core/save/prefs.gd"
VSave="*res://core/save/save_system.gd"
VUI="*res://ui/ui_root.gd"
Net="*res://net/Net.gd"

[boot_splash]

bg_color=Color(0, 0, 0, 1)
image="res://branding/splash.png"
fullsize=true
use_filter=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
anti_aliasing/quality/msaa_3d=1

