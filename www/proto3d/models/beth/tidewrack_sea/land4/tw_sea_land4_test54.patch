 	if n == "ash_lava_seams":
 		var l := _sh("stage4/shaders/lava_seam.gdshader"); l.set_shader_parameter("energy", 6.0); return l
 	if n == "ash_steam": return _sh("stage4/shaders/steam_plume.gdshader")
+	if _land4_terrain(n):
+		return _land4_mat(n)
 	if n.begins_with("ash_"):   # stage 4 README: black basalt = vertex colour + metallic_specular 0.15 (else it mirrors the haze and reads beige)
 		var b := StandardMaterial3D.new(); b.vertex_color_use_as_albedo = true; b.roughness = 0.9; b.metallic_specular = 0.15; return b
 	return load(R + "stage1/shaders/vc_lit.tres")
+
+func _land4_terrain(n: String) -> bool:
+	if n.contains("land_scatter") or n.ends_with("_col") or n.ends_with("_glow") or n.ends_with("_port"):
+		return false
+	return n.contains("_tile_") or n == "arch_islands" or n.contains("_isl_")
+
+func _land4_mat(n: String) -> ShaderMaterial:
+	var t := _sh("stage1/shaders/vc_terrain.gdshader")
+	t.set_shader_parameter("region", ["arch_", "coast_", "frost_", "ash_"].find(n.substr(0, n.find("_") + 1)))
+	_bind_land4(t)
+	if n.begins_with("ash_"):
+		t.set_shader_parameter("lift", 0.06)
+		t.set_shader_parameter("ambient", 0.45)
+		t.set_shader_parameter("spec", 0.12)
+	if not high():
+		t.set_shader_parameter("detail", 0.55)
+	return t
+
+var _surf_col: Texture2DArray
+var _surf_nrm: Texture2DArray
+func _bind_land4(mat: ShaderMaterial) -> void:
+	if _surf_col == null:
+		var root := "res://tidewrack/land4/textures/"
+		var cols: Array[Image] = []
+		var nrms: Array[Image] = []
+		for key in ["grass", "earth", "sand", "rock", "snow"]:
+			var alb := _land4_jpg(root + key + "_albedo.jpg")
+			alb.generate_mipmaps()
+			cols.append(alb)
+			nrms.append(_land4_pack(_land4_jpg(root + key + "_normal.jpg"), _land4_jpg(root + key + "_rough.jpg")))
+		_surf_col = Texture2DArray.new()
+		if _surf_col.create_from_images(cols) != OK:
+			push_error("land4 surf_col array failed")
+		_surf_nrm = Texture2DArray.new()
+		if _surf_nrm.create_from_images(nrms) != OK:
+			push_error("land4 surf_nrm array failed")
+	mat.set_shader_parameter("surf_col", _surf_col)
+	mat.set_shader_parameter("surf_nrm", _surf_nrm)
+
+func _land4_jpg(res_path: String) -> Image:
+	var img := Image.load_from_file(ProjectSettings.globalize_path(res_path))
+	if img == null:
+		push_error("land4 texture missing: " + res_path)
+		return Image.create(4, 4, false, Image.FORMAT_RGB8)
+	if img.get_format() != Image.FORMAT_RGB8:
+		img.convert(Image.FORMAT_RGB8)
+	return img
+
+func _land4_pack(nrm: Image, rgh: Image) -> Image:
+	var out := nrm.get_data().duplicate()
+	var rb := rgh.get_data()
+	var n := mini(out.size() / 3, rb.size() / 3)
+	for i in n:
+		out[i * 3 + 2] = rb[i * 3]
+	var img := Image.create_from_data(nrm.get_width(), nrm.get_height(), false, Image.FORMAT_RGB8, out)
+	img.generate_mipmaps()
+	return img
+
+
 func _no_shadow(n: String) -> bool:
 	for k in ["_fog_layers", "_storm_sky", "_storm_sea", "_glow", "_steam", "_lava_seams", "buoy_", "upg_", "_ice_floes", "_icicles"]:
 		if n.find(k) >= 0: return true
