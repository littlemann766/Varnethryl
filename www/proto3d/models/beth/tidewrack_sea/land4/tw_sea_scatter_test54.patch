+var _scatter_bark: Texture2D
+var _scatter_bark_n: Texture2D
+var _scatter_rock: Texture2D
+var _scatter_atlas: Texture2D
+
+func _scatter_mat() -> ShaderMaterial:
+	var m := _sh("stage1/shaders/vc_scatter.gdshader")
+	if _scatter_bark == null:
+		var root := "res://tidewrack/land4/textures/"
+		_scatter_bark = _scatter_tex(root + "bark_albedo.jpg", false)
+		_scatter_bark_n = _scatter_tex(root + "bark_normal.jpg", false)
+		_scatter_rock = _scatter_tex(root + "rock_albedo.jpg", false)
+		_scatter_atlas = _scatter_tex(root + "foliage_atlas.png", true)
+	m.set_shader_parameter("bark_col", _scatter_bark)
+	m.set_shader_parameter("bark_nrm", _scatter_bark_n)
+	m.set_shader_parameter("rock_col", _scatter_rock)
+	m.set_shader_parameter("leaf_atlas", _scatter_atlas)
+	return m
+
+func _scatter_tex(res_path: String, rgba: bool) -> Texture2D:
+	var img := Image.load_from_file(ProjectSettings.globalize_path(res_path))
+	if img == null:
+		push_error("scatter texture missing: " + res_path)
+		img = Image.create(4, 4, false, Image.FORMAT_RGBA8 if rgba else Image.FORMAT_RGB8)
+	elif rgba and img.get_format() != Image.FORMAT_RGBA8:
+		img.convert(Image.FORMAT_RGBA8)
+	elif (not rgba) and img.get_format() != Image.FORMAT_RGB8:
+		img.convert(Image.FORMAT_RGB8)
+	img.generate_mipmaps()
+	return ImageTexture.create_from_image(img)
+
